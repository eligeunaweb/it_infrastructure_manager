<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_sysadmin_server" model="ir.actions.act_window">
        <field name="name">Servers</field>
        <field name="res_model">sysadmin.server</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{}</field>
    </record>

    <record id="view_sysadmin_server_tree" model="ir.ui.view">
        <field name="name">sysadmin.server.tree</field>
        <field name="model">sysadmin.server</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'inactive'" decoration-success="state == 'active'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="location"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-danger="state == 'inactive'"/>
                <field name="responsible_user_id"/>
            </list>
        </field>
    </record>

    <record id="view_sysadmin_server_form" model="ir.ui.view">
        <field name="name">sysadmin.server.form</field>
        <field name="model">sysadmin.server</field>
        <field name="arch" type="xml">
            <form class="euw_it_form">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_deactivate" type="object" string="Deactivate" class="btn-secondary" invisible="state == 'inactive'"/>
                    <field name="state" widget="statusbar" options="{'clickable': true}"/>
                </header>
                <sheet class="euw_it_sheet">
                        <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title euw_it_title">
                        <h1><field name="name" placeholder="e.g. srv-web-01"/></h1>
                    </div>
                    <div class="euw_it_hero">
                        <div>
                            <span class="euw_it_kicker">IT INFRASTRUCTURE</span>
                            <h3>Server overview</h3>
                            <p>Hardware, networking, DNS and ownership in one place.</p>
                        </div>
                    </div>

                    <group>
                        <group string="Customer">
                            <field name="partner_id"/>
                            <field name="responsible_user_id"/>
                            <field name="location"/>
                        </group>
                        <group string="Keycloak">
                            <field name="keycloak_client"/>
                            <field name="keycloak_secret" password="True"/>
                        </group>
                    </group>

                    <group string="Hardware">
                        <field name="motherboard"/>
                        <field name="cpu"/>
                        <field name="ram_gb"/>
                        <field name="storage_type"/>
                        <field name="storage_size_gb"/>
                    </group>

                    <notebook>
                        <page string="Network Interfaces">
                            <field name="interface_ids" context="{'default_server_id': id}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="dns_name"/>
                                    <field name="mac"/>
                                    <field name="ipv4"/>
                                    <field name="ipv6"/>
                                    <field name="connected_to"/>
                                    <field name="port"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Server DNS">
                            <field name="dns_record_ids" context="{'default_server_id': id, 'default_partner_id': partner_id, 'default_zone_id': False}">
                                <list editable="bottom">
                                    <field name="zone_id"/>
                                    <field name="name"/>
                                    <field name="record_type"/>
                                    <field name="value"/>
                                    <field name="ttl"/>
                                    <field name="priority" optional="show"/>
                                    <field name="weight" optional="hide"/>
                                    <field name="port" optional="hide"/>
                                    <field name="comment" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="description" placeholder="General information, credentials, observations…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sysadmin_server_kanban" model="ir.ui.view">
        <field name="name">sysadmin.server.kanban</field>
        <field name="model">sysadmin.server</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('sysadmin.server', 'image_128', record.id.raw_value)" class="o_image_64_contain"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div><field name="partner_id"/></div>
                                <div>[<field name="state"/>]</div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

<record id="view_sysadmin_server_interface_list" model="ir.ui.view">
        <field name="name">sysadmin.server.interface.list</field>
        <field name="model">sysadmin.server.interface</field>
        <field name="arch" type="xml">
            <list string="Network Interfaces">
                <field name="server_id"/>
                <field name="name"/>
                <field name="dns_name"/>
                <field name="mac"/>
                <field name="ipv4"/>
                <field name="ipv6" optional="hide"/>
                <field name="connected_to"/>
                <field name="port"/>
            </list>
        </field>
    </record>

    <record id="view_sysadmin_server_interface_form" model="ir.ui.view">
        <field name="name">sysadmin.server.interface.form</field>
        <field name="model">sysadmin.server.interface</field>
        <field name="arch" type="xml">
            <form string="Network Interface" class="euw_it_form">
                <sheet class="euw_it_sheet">
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. ens18"/></h1>
                    </div>
                    <group>
                        <group string="Server">
                            <field name="server_id"/>
                            <field name="dns_name"/>
                            <field name="mac"/>
                        </group>
                        <group string="Network">
                            <field name="ipv4"/>
                            <field name="ipv6"/>
                            <field name="connected_to"/>
                            <field name="port"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sysadmin_server_interface_search" model="ir.ui.view">
        <field name="name">sysadmin.server.interface.search</field>
        <field name="model">sysadmin.server.interface</field>
        <field name="arch" type="xml">
            <search string="Network Interfaces">
                <field name="name"/>
                <field name="server_id"/>
                <field name="dns_name"/>
                <field name="mac"/>
                <field name="ipv4"/>
                <field name="connected_to"/>
                <filter string="Server" name="group_server" context="{'group_by': 'server_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_sysadmin_server_interface" model="ir.actions.act_window">
        <field name="name">Network Interfaces</field>
        <field name="res_model">sysadmin.server.interface</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sysadmin_server_interface_search"/>
    </record>
</odoo>
